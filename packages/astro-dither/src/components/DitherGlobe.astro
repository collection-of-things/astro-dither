---
import { orderedDitherAttribute } from "../lib/ordered-dither";
import land from "../assets/land.png";

interface Props {
  class?: string;
  src?: string;
  lat?: number;
  lon?: number;
  /** Tone of the sea, 0 to 1. 0 leaves it clear so only land shows. */
  sea?: number;
  /** Spin speed. 0 holds the globe still. */
  speed?: number;
  /** Tones the field snaps to before dithering. Low values give hard steps. */
  levels?: number;
  /** The moment drawn when motion is off or reduced, in seconds. */
  stillTime?: number;
  /** Bloom around lit cells, 0 to 1. 0 adds none. CSS `--dither-bloom` overrides it, for hover states. */
  bloom?: number;
  /** Bloom blur in CSS pixels. CSS `--dither-bloom-radius` overrides it. */
  bloomRadius?: number;
  cell?: number;
  matrix?: 2 | 4 | 8 | "noise";
  palette?: string[];
}

const {
  class: className,
  src = land.src,
  lat = 20,
  lon = 48,
  sea = 0.12,
  speed = 1,
  levels,
  stillTime,
  bloom,
  bloomRadius,
  cell = 2.5,
  matrix = 4,
  palette = ["transparent", "#f4f1ea"],
} = Astro.props;

const encoded = orderedDitherAttribute({ effect: "globe", params: { lat, lon, sea }, src, speed, levels, stillTime, bloom, bloomRadius, cell, matrix, palette });
---

<dither-surface class={className} data-dither={encoded} aria-hidden="true"></dither-surface>

<script>
  import { defineOrderedDither } from "../lib/mount-ordered-dither";

  defineOrderedDither();
</script>

<style>
  dither-surface {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  dither-surface :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
