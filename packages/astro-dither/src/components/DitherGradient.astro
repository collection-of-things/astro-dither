---
import { orderedDitherAttribute } from "../lib/ordered-dither";

const MODE_NUMBERS = { linear: 0, radial: 1, conic: 2, wave: 3 } as const;

interface Props {
  class?: string;
  mode?: keyof typeof MODE_NUMBERS;
  angle?: number;
  centerX?: number;
  centerY?: number;
  radius?: number;
  from?: number;
  to?: number;
  /** Animation speed. 0 draws one still frame. */
  speed?: number;
  /** Tones the field snaps to before dithering. Low values give hard steps. */
  levels?: number;
  /** The moment drawn when motion is off or reduced, in seconds. */
  stillTime?: number;
  /** Bloom around lit cells, 0 to 1. 0 adds none. CSS `--dither-bloom` overrides it, for hover states. */
  bloom?: number;
  /** Bloom blur in CSS pixels. CSS `--dither-bloom-radius` overrides it. */
  bloomRadius?: number;
  cell?: number;
  matrix?: 2 | 4 | 8 | "noise";
  palette?: string[];
}

const { class: className, mode = "radial", palette, angle, centerX, centerY, radius, from, to, speed, levels, stillTime, bloom, bloomRadius, cell, matrix } = Astro.props;
const encoded = orderedDitherAttribute({
  effect: "gradient",
  params: { mode: MODE_NUMBERS[mode], angle, cx: centerX, cy: centerY, radius, from, to },
  palette,
  cell,
  matrix,
  speed,
  levels,
  stillTime,
  bloom,
  bloomRadius,
});
---

<dither-surface class={className} data-dither={encoded} aria-hidden="true"></dither-surface>

<script>
  import { defineOrderedDither } from "../lib/mount-ordered-dither";

  defineOrderedDither();
</script>

<style>
  dither-surface {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  dither-surface :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
