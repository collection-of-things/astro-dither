---
import { orderedDitherAttribute } from "../lib/ordered-dither";

const MODE_NUMBERS = { linear: 0, radial: 1, conic: 2, wave: 3 } as const;

interface Props {
  class?: string;
  mode?: keyof typeof MODE_NUMBERS;
  angle?: number;
  centerX?: number;
  centerY?: number;
  radius?: number;
  from?: number;
  to?: number;
  /** Animation speed. 0 draws one still frame. */
  speed?: number;
  cell?: number;
  matrix?: 2 | 4 | 8 | "noise";
  palette?: string[];
}

const { class: className, mode = "radial", palette, angle, centerX, centerY, radius, from, to, speed, cell, matrix } = Astro.props;
const encoded = orderedDitherAttribute({
  effect: "gradient",
  params: { mode: MODE_NUMBERS[mode], angle, cx: centerX, cy: centerY, radius, from, to },
  palette,
  cell,
  matrix,
  speed,
});
---

<dither-surface class={className} data-dither={encoded} aria-hidden="true"></dither-surface>

<script>
  import { defineOrderedDither } from "../lib/mount-ordered-dither";

  defineOrderedDither();
</script>

<style>
  dither-surface {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  dither-surface :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
