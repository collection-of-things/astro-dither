---
import Base from "./Base.astro";
import { NAV, neighbours } from "../docs/nav";

interface TocItem {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  title: string;
  description: string;
  href: string;
  md?: string;
  toc?: TocItem[];
}

const { title, description, href, md, toc = [] } = Astro.props;
const { prev, next } = neighbours(href);
const mdPath = md ?? `${href === "/docs" ? "/docs" : href}.md`;
---

<Base title={`${title} | astro-dither docs`} description={description}>
  <button class="drawer-btn" type="button" data-open-drawer>
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    Menu
  </button>
  <div class="drawer" id="docs-drawer" hidden>
    <div class="drawer-back" data-close-drawer></div>
    <aside class="drawer-panel">
      {NAV.map((s) => (
        <div class="nav-sec">
          {s.collapsible ? (
            <details open>
              <summary class="nav-head nav-summary">{s.title}{s.count ? ` (${s.count})` : ""}</summary>
              {s.items.map((i) => (
                <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
              ))}
            </details>
          ) : (
            <>
              <p class="nav-head">{s.title}{s.count ? ` (${s.count})` : ""}</p>
              {s.items.map((i) => (
                <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
              ))}
            </>
          )}
        </div>
      ))}
    </aside>
  </div>

  <div class="docs-wrap">
    <aside class="side">
      {NAV.map((s) => (
        <div class="nav-sec">
          {!s.collapsible && <p class="nav-head">{s.title}{s.count ? ` (${s.count})` : ""}</p>}
          {s.collapsible ? (
            <details open={s.items.some((i) => i.href === href)}>
              <summary class="nav-head nav-summary">{s.title}{s.count ? ` (${s.count})` : ""}</summary>
              {s.items.map((i) => (
                <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
              ))}
            </details>
          ) : (
            s.items.map((i) => (
              <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
            ))
          )}
        </div>
      ))}
    </aside>

    <main class="content">
      <div class="doc-head">
        <div>
          <h1>{title}</h1>
          <p class="doc-desc">{description}</p>
        </div>
        <div class="doc-actions">
          <button class="copy-page" type="button" data-copy-page={mdPath}>Copy page</button>
          <div class="pager-arrows">
            {prev ? (
              <a class="pg" href={prev.href} aria-label={`Previous: ${prev.title}`}>&larr;</a>
            ) : <span class="pg off" aria-hidden="true">&larr;</span>}
            {next ? (
              <a class="pg" href={next.href} aria-label={`Next: ${next.title}`}>&rarr;</a>
            ) : <span class="pg off" aria-hidden="true">&rarr;</span>}
          </div>
        </div>
      </div>

      <article class="doc-body">
        <slot />
      </article>

      <nav class="pager" aria-label="Page">
        {prev ? (
          <a class="pg-card" href={prev.href}>
            <span class="pg-dir">&larr; Previous</span>
            <span class="pg-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pg-card next" href={next.href}>
            <span class="pg-dir">Next &rarr;</span>
            <span class="pg-title">{next.title}</span>
          </a>
        ) : <span />}
      </nav>
    </main>

    <aside class="toc">
      <p class="toc-head">On this page</p>
      <nav>
        {toc.map((h) => (
          <a class:list={["toc-item", { d3: h.depth >= 3 }]} href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
        ))}
      </nav>
      <a class="toc-md" href={mdPath}>View as Markdown</a>
    </aside>
  </div>

  <script>
    // Copy the page's markdown mirror.
    document.querySelector("[data-copy-page]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const path = btn.getAttribute("data-copy-page");
      if (!path) return;
      try {
        const res = await fetch(path);
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        const old = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = old), 1200);
      } catch {
        btn.textContent = "Failed";
      }
    });
    // TOC highlight on scroll.
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
    const heads = links
      .map((l) => document.getElementById(l.getAttribute("data-toc") ?? ""))
      .filter((el): el is HTMLElement => el !== null);
    if (links.length > 0 && heads.length > 0) {
      const mark = () => {
        let current = 0;
        heads.forEach((h, i) => {
          if (h.getBoundingClientRect().top <= 100) current = i;
        });
        links.forEach((l, i) => l.classList.toggle("on", i === current));
      };
      addEventListener("scroll", mark, { passive: true });
      mark();
    }
    document.querySelector("[data-open-drawer]")?.addEventListener("click", () =>
      document.getElementById("docs-drawer")?.removeAttribute("hidden"),
    );
    document.querySelectorAll("[data-close-drawer], .drawer-panel a").forEach((b) =>
      b.addEventListener("click", () => document.getElementById("docs-drawer")?.setAttribute("hidden", "")),
    );
  </script>
</Base>

<style>
  .docs-wrap {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px) 200px;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--header-offset) 24px 80px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: var(--header-offset);
    max-height: calc(100vh - var(--header-offset) - 18px);
    overflow-y: auto;
    overflow-x: hidden;
    font-size: 14px;
    padding-left: 10px;
    margin-left: -10px;
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .side::-webkit-scrollbar {
    width: 6px;
  }
  .side::-webkit-scrollbar-thumb {
    background: #2a2e35;
    border-radius: 3px;
  }
  .side::-webkit-scrollbar-track {
    background: transparent;
  }
  .nav-sec {
    margin-bottom: 22px;
  }
  .nav-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 6px;
    text-transform: none;
    letter-spacing: 0;
  }
  .nav-item {
    display: block;
    padding: 5px 10px;
    margin-left: -10px;
    border-radius: 7px;
    color: var(--muted);
    text-decoration: none;
  }
  .nav-item:hover {
    color: var(--ink);
  }
  .nav-item.on {
    color: var(--ink);
    background: var(--line);
  }
  .nav-summary {
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    margin-bottom: 6px;
  }
  .nav-summary::after {
    content: "›";
    float: right;
    transition: transform 0.2s ease;
  }
  details[open] > .nav-summary::after {
    transform: rotate(90deg);
  }
  .content {
    min-width: 0;
  }
  .doc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .doc-head h1 {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .doc-desc {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
  }
  .doc-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding-top: 6px;
  }
  .copy-page {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color var(--t-hover) ease, border-color var(--t-hover) ease;
  }
  .copy-page:hover {
    color: var(--ink);
    border-color: #262a31;
  }
  .pager-arrows {
    display: flex;
    gap: 4px;
  }
  .pg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
  }
  .pg:hover {
    color: var(--ink);
    border-color: #262a31;
  }
  .pg.off {
    opacity: 0.35;
  }
  .doc-body :global(h2) {
    font-size: 22px;
    font-weight: 500;
    margin: 44px 0 14px;
    scroll-margin-top: calc(var(--header-offset) + 16px);
  }
  .doc-body :global(h3) {
    font-size: 16px;
    font-weight: 500;
    margin: 30px 0 10px;
    scroll-margin-top: calc(var(--header-offset) + 16px);
  }
  .doc-body :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .doc-body :global(ul),
  .doc-body :global(ol) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    padding-left: 22px;
    margin: 0 0 14px;
  }
  .doc-body :global(li) {
    margin-bottom: 4px;
  }
  .doc-body :global(code) {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.92em;
    color: var(--ink);
    background: var(--line);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .doc-body :global(pre) {
    background: #0b0c0e;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    overflow-x: auto;
    margin: 0 0 16px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .doc-body :global(pre::-webkit-scrollbar) {
    width: 6px;
    height: 6px;
  }
  .doc-body :global(pre::-webkit-scrollbar-thumb) {
    background: #2a2e35;
    border-radius: 3px;
  }
  .doc-body :global(pre::-webkit-scrollbar-track) {
    background: transparent;
  }
  .doc-body :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 13px;
  }
  .doc-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 0 0 20px;
  }
  .doc-body :global(th),
  .doc-body :global(td) {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    vertical-align: top;
  }
  .doc-body :global(th) {
    color: var(--ink);
    font-weight: 500;
    font-size: 13px;
  }
  .doc-body :global(td:first-child code),
  .doc-body :global(th) {
    white-space: nowrap;
  }
  .doc-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .doc-body :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pg-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    min-width: 180px;
    text-decoration: none;
    transition: border-color var(--t-hover) ease;
  }
  .pg-card:hover {
    border-color: #262a31;
  }
  .pg-card.next {
    text-align: right;
    margin-left: auto;
  }
  .pg-dir {
    font-size: 12px;
    color: var(--muted);
  }
  .pg-title {
    font-size: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .toc {
    position: sticky;
    top: var(--header-offset);
    max-height: calc(100vh - var(--header-offset) - 24px);
    overflow-y: auto;
    overflow-x: hidden;
    font-size: 13px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .toc::-webkit-scrollbar {
    width: 6px;
  }
  .toc::-webkit-scrollbar-thumb {
    background: #2a2e35;
    border-radius: 3px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .toc-item {
    display: block;
    padding: 3px 0 3px 12px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-item.d3 {
    padding-left: 24px;
  }
  .toc-item:hover {
    color: var(--ink);
  }
  .toc-item.on {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  .toc-md {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-md:hover {
    color: var(--ink);
  }
  .drawer-btn {
    display: none;
  }
  .drawer[hidden] {
    display: none;
  }
  .doc-body :global(.table-wrap) {
    overflow-x: auto;
    margin-bottom: 20px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .doc-body :global(.table-wrap::-webkit-scrollbar) {
    height: 6px;
  }
  .doc-body :global(.table-wrap::-webkit-scrollbar-thumb) {
    background: #2a2e35;
    border-radius: 3px;
  }
  .doc-body :global(.table-wrap::-webkit-scrollbar-track) {
    background: transparent;
  }
  .doc-body :global(.table-wrap table) {
    min-width: 640px;
    margin: 0;
  }
  @media (max-width: 1150px) {
    .docs-wrap {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .docs-wrap {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px 16px 64px;
    }
    .side {
      display: none;
    }
    .drawer-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      position: sticky;
      top: var(--header-offset);
      margin-top: var(--header-offset);
      z-index: 40;
      width: 100%;
      height: 40px;
      padding: 0 16px;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: rgba(11, 12, 14, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: var(--ink);
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
    }
    .drawer-btn svg {
      flex: none;
      color: var(--muted);
    }
    .drawer {
      position: fixed;
      inset: 0;
      z-index: 100;
    }
    .drawer-back {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
    }
    .drawer-panel {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 260px;
      background: var(--card);
      border-right: 1px solid var(--line);
      overflow-y: auto;
      padding: 20px 14px;
      font-size: 14px;
    }
  }
</style>
