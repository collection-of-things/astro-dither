---
import Base from "./Base.astro";
import { Button } from "../components/starwind/button";
import Card from "../components/starwind/card";
import Sheet from "../components/starwind/sheet";
import { NAV, neighbours } from "../docs/nav";
import pkg from "../../../packages/astro-dither/package.json";

interface TocItem {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  title: string;
  description: string;
  href: string;
  md?: string;
  toc?: TocItem[];
}

const { title, description, href, md, toc = [] } = Astro.props;
const { prev, next } = neighbours(href);
const mdPath = md ?? `${href === "/docs" ? "/docs" : href}.md`;
---

<Base title={`${title} | astro-dither docs`} description={description}>
  <button class="drawer-btn" type="button" data-sw-drawer-trigger data-sw-drawer-target-id="docs-drawer">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    Menu
  </button>
  <Sheet.Root id="docs-drawer">
    <Sheet.Content side="left" class="docs-drawer bg-card">
      <Sheet.Title class="sr-only">Docs menu</Sheet.Title>
      <nav class="drawer-nav" aria-label="Docs">
        {NAV.map((s) => (
          <div class="nav-sec">
            {s.collapsible ? (
              <details open>
                <summary class="nav-head nav-summary">{s.title}{s.count ? ` (${s.count})` : ""}</summary>
                {s.items.map((i) => (
                  <a class:list={["nav-item", { on: i.href === href }]} href={i.href} data-sw-drawer-close>{i.title}</a>
                ))}
              </details>
            ) : (
              <>
                <p class="nav-head">{s.title}{s.count ? ` (${s.count})` : ""}</p>
                {s.items.map((i) => (
                  <a class:list={["nav-item", { on: i.href === href }]} href={i.href} data-sw-drawer-close>{i.title}</a>
                ))}
              </>
            )}
          </div>
        ))}
      </nav>
    </Sheet.Content>
  </Sheet.Root>

  <div class="docs-wrap">
    <aside class="side">
      {NAV.map((s) => (
        <div class="nav-sec">
          {!s.collapsible && <p class="nav-head">{s.title}{s.count ? ` (${s.count})` : ""}</p>}
          {s.collapsible ? (
            <details open={s.items.some((i) => i.href === href)}>
              <summary class="nav-head nav-summary">{s.title}{s.count ? ` (${s.count})` : ""}</summary>
              {s.items.map((i) => (
                <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
              ))}
            </details>
          ) : (
            s.items.map((i) => (
              <a class:list={["nav-item", { on: i.href === href }]} href={i.href}>{i.title}</a>
            ))
          )}
        </div>
      ))}
      <p class="side-ver">v{pkg.version}</p>
    </aside>

    <main class="content">
      <div class="doc-head">
        <div>
          <h1>{title}</h1>
          <p class="doc-desc">{description}</p>
        </div>
        <div class="doc-actions">
          <Button variant="outline" size="sm" class="copy-page" data-copy-page={mdPath}>Copy page</Button>
          <div class="pager-arrows">
            {prev ? (
              <Button href={prev.href} variant="outline" size="icon-sm" class="pg" aria-label={`Previous: ${prev.title}`}>&larr;</Button>
            ) : <Button variant="outline" size="icon-sm" class="pg" disabled aria-hidden="true">&larr;</Button>}
            {next ? (
              <Button href={next.href} variant="outline" size="icon-sm" class="pg" aria-label={`Next: ${next.title}`}>&rarr;</Button>
            ) : <Button variant="outline" size="icon-sm" class="pg" disabled aria-hidden="true">&rarr;</Button>}
          </div>
        </div>
      </div>

      <article class="doc-body">
        <slot />
      </article>

      <nav class="pager" aria-label="Page">
        {prev ? (
          <a class="pg-link" href={prev.href}>
            <Card.Root class="pg-card">
              <span class="pg-dir">&larr; Previous</span>
              <span class="pg-title">{prev.title}</span>
            </Card.Root>
          </a>
        ) : <span />}
        {next ? (
          <a class="pg-link" href={next.href}>
            <Card.Root class="pg-card next">
              <span class="pg-dir">Next &rarr;</span>
              <span class="pg-title">{next.title}</span>
            </Card.Root>
          </a>
        ) : <span />}
      </nav>
    </main>

    <aside class="toc">
      <p class="toc-head">On this page</p>
      <nav>
        {toc.map((h) => (
          <a class:list={["toc-item", { d3: h.depth >= 3 }]} href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
        ))}
      </nav>
      <a class="toc-md" href={mdPath}>View as Markdown</a>
    </aside>
  </div>

  <script>
    // Copy the page's markdown mirror.
    document.querySelector("[data-copy-page]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const path = btn.getAttribute("data-copy-page");
      if (!path) return;
      try {
        const res = await fetch(path);
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        const old = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = old), 1200);
      } catch {
        btn.textContent = "Failed";
      }
    });
    // TOC highlight on scroll.
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
    const heads = links
      .map((l) => document.getElementById(l.getAttribute("data-toc") ?? ""))
      .filter((el): el is HTMLElement => el !== null);
    if (links.length > 0 && heads.length > 0) {
      const mark = () => {
        let current = 0;
        heads.forEach((h, i) => {
          if (h.getBoundingClientRect().top <= 100) current = i;
        });
        links.forEach((l, i) => l.classList.toggle("on", i === current));
      };
      addEventListener("scroll", mark, { passive: true });
      mark();
    }
    // Pause Lenis while the docs drawer is open.
    const lenisApi = () =>
      (window as { __lenis?: { stop(): void; start(): void } }).__lenis;
    document.getElementById("docs-drawer")?.addEventListener("starwind:open-change", (e) => {
      if (!(e instanceof CustomEvent)) return;
      const open = (e.detail as { open?: boolean }).open;
      if (open) lenisApi()?.stop();
      else lenisApi()?.start();
    });
  </script>
</Base>

<style>
  .docs-wrap {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px) 200px;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--header-offset) 24px 80px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: var(--header-offset);
    max-height: calc(100vh - var(--header-offset) - 18px);
    overflow-y: auto;
    overflow-x: hidden;
    font-size: 14px;
    padding-left: 10px;
    margin-left: -10px;
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .side::-webkit-scrollbar {
    width: 6px;
  }
  .side::-webkit-scrollbar-thumb {
    background: #2a2e35;
    border-radius: 3px;
  }
  .side::-webkit-scrollbar-track {
    background: transparent;
  }
  .nav-sec {
    margin-bottom: 22px;
  }
  .nav-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 6px;
    text-transform: none;
    letter-spacing: 0;
  }
  .nav-item {
    display: block;
    padding: 5px 10px;
    margin-left: -10px;
    border-radius: 7px;
    color: var(--muted);
    text-decoration: none;
  }
  .nav-item:hover {
    color: var(--ink);
  }
  .nav-item.on {
    color: var(--ink);
    background: var(--line);
  }
  .nav-summary {
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    margin-bottom: 6px;
  }
  .nav-summary::after {
    content: "›";
    float: right;
    transition: transform 0.2s ease;
  }
  details[open] > .nav-summary::after {
    transform: rotate(90deg);
  }
  .side-ver {
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted);
  }
  .content {
    min-width: 0;
  }
  .doc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .doc-head h1 {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .doc-desc {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
  }
  .doc-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding-top: 6px;
  }
  .copy-page {
    height: 30px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 400;
  }
  .pager-arrows {
    display: flex;
    gap: 4px;
  }
  .pg {
    width: 30px;
    height: 30px;
    font-size: 14px;
  }
  .doc-body :global(h2) {
    font-size: 22px;
    font-weight: 500;
    margin: 44px 0 14px;
    scroll-margin-top: calc(var(--header-offset) + 16px);
  }
  .doc-body :global(h3) {
    font-size: 16px;
    font-weight: 500;
    margin: 30px 0 10px;
    scroll-margin-top: calc(var(--header-offset) + 16px);
  }
  .doc-body :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .doc-body :global(ul),
  .doc-body :global(ol) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    padding-left: 22px;
    margin: 0 0 14px;
  }
  .doc-body :global(li) {
    margin-bottom: 4px;
  }
  /* Inline code only; framed code blocks (Expressive Code) own their styling. */
  .doc-body :global(:not(pre) > code) {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.92em;
    color: var(--ink);
    background: var(--line);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .doc-body :global(.expressive-code) {
    margin: 0 0 16px;
  }
  .doc-body :global(td:first-child code),
  .doc-body :global([data-slot="table-head"]) {
    white-space: nowrap;
  }
  .doc-body :global([data-slot="table"]) {
    font-size: 14px;
    margin: 0 0 20px;
  }
  .doc-body :global([data-slot="table-cell"]) {
    color: var(--muted);
    vertical-align: top;
  }
  .doc-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .doc-body :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pg-link {
    min-width: 180px;
    text-decoration: none;
  }
  .pg-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    transition: border-color var(--t-hover) ease;
  }
  .pg-link:hover .pg-card {
    border-color: #262a31;
  }
  .pg-card.next {
    text-align: right;
  }
  .pg-dir {
    font-size: 12px;
    color: var(--muted);
  }
  .pg-title {
    font-size: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .toc {
    position: sticky;
    top: var(--header-offset);
    max-height: calc(100vh - var(--header-offset) - 24px);
    overflow-y: auto;
    overflow-x: hidden;
    font-size: 13px;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .toc::-webkit-scrollbar {
    width: 6px;
  }
  .toc::-webkit-scrollbar-thumb {
    background: #2a2e35;
    border-radius: 3px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .toc-item {
    display: block;
    padding: 3px 0 3px 12px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-item.d3 {
    padding-left: 24px;
  }
  .toc-item:hover {
    color: var(--ink);
  }
  .toc-item.on {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  .toc-md {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-md:hover {
    color: var(--ink);
  }
  .drawer-btn {
    display: none;
  }
  .drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 20px 14px;
    font-size: 14px;
    overflow-y: auto;
    height: 100%;
  }
  @media (max-width: 1150px) {
    .docs-wrap {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .docs-wrap {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px 16px 64px;
    }
    .side {
      display: none;
    }
    .drawer-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      position: sticky;
      top: var(--header-offset);
      margin-top: var(--header-offset);
      z-index: 40;
      width: 100%;
      height: 40px;
      padding: 0 16px;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: rgba(11, 12, 14, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: var(--ink);
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
    }
    .drawer-btn svg {
      flex: none;
      color: var(--muted);
    }
    :global(.docs-drawer) {
      width: 260px;
      padding: 0;
      border-right: 1px solid var(--line);
    }
  }
</style>
