---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  value: string;
  label?: string;
  size?: "sm" | "md";
}

const { value, label = "Copy to clipboard", size = "md", class: className, ...rest } = Astro.props;
---

<button
  class:list={["copybtn", `s-${size}`, className]}
  data-copybtn
  data-value={value}
  data-copied="false"
  aria-label={label}
  type="button"
  {...rest}
>
  <span class="sr-only" aria-live="polite" aria-atomic="true"></span>
  <span class="ic-wrap" aria-hidden="true">
    <svg class="ic ic-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <svg class="ic ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path class="tick" d="M20 6 9 17l-5-5" />
    </svg>
  </span>
</button>

<style>
  .copybtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--t-hover, 200ms) ease,
      background var(--t-hover, 200ms) ease,
      transform 150ms ease;
  }
  .copybtn::before {
    content: "";
    position: absolute;
    inset: -8px;
  }
  .copybtn:hover {
    color: var(--ink);
    background: var(--line);
  }
  .copybtn:active {
    transform: scale(0.96);
  }
  .copybtn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .s-sm {
    width: 28px;
    height: 28px;
  }
  .s-md {
    width: 32px;
    height: 32px;
  }
  .ic-wrap {
    position: relative;
    display: inline-flex;
    width: 15px;
    height: 15px;
  }
  .ic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      filter 300ms ease,
      color 300ms ease;
  }
  .ic-check {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copybtn[data-copied="true"] .ic-copy {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copybtn[data-copied="true"] .ic-check {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
    color: var(--accent);
  }
  .tick {
    stroke-dasharray: 23;
    stroke-dashoffset: 23;
  }
  .copybtn[data-copied="true"] .tick {
    animation: tick-draw 350ms ease forwards;
  }
  @keyframes tick-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .ic {
      transition: none;
    }
    .copybtn[data-copied="true"] .tick {
      animation: none;
      stroke-dashoffset: 0;
    }
    .copybtn:active {
      transform: none;
    }
  }
</style>

<script>
  const copyTimers = new WeakMap<Element, number>();
  const legacyCopy = (value: string) => {
    const ta = document.createElement("textarea");
    ta.value = value;
    ta.setAttribute("readonly", "");
    ta.style.cssText = "position:fixed;opacity:0;pointer-events:none";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, value.length);
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    ta.remove();
    return ok;
  };
  document.addEventListener("click", async (e) => {
    const target = e.target instanceof Element ? e.target : null;
    const btn = target?.closest?.("[data-copybtn]");
    if (!btn) return;
    const value = btn.getAttribute("data-value") ?? "";
    if (!value) return;
    let ok = false;
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        ok = true;
      } catch {
        ok = legacyCopy(value);
      }
    } else {
      ok = legacyCopy(value);
    }
    if (!ok) return;
    const originalLabel = btn.getAttribute("data-orig-label") ?? btn.getAttribute("aria-label") ?? "";
    btn.setAttribute("data-orig-label", originalLabel);
    btn.setAttribute("data-copied", "true");
    btn.setAttribute("aria-label", "Copied to clipboard");
    const live = btn.querySelector(".sr-only");
    if (live) live.textContent = "Copied";
    const prev = copyTimers.get(btn);
    if (prev) clearTimeout(prev);
    copyTimers.set(
      btn,
      window.setTimeout(() => {
        btn.setAttribute("data-copied", "false");
        btn.setAttribute("aria-label", originalLabel);
        if (live) live.textContent = "";
      }, 2000),
    );
  });
</script>
