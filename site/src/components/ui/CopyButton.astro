---
import Check from "@tabler/icons/outline/check.svg";
import Copy from "@tabler/icons/outline/copy.svg";
import type { HTMLAttributes } from "astro/types";
import { Button } from "../starwind/button";
import Tooltip from "../starwind/tooltip";

interface Props extends HTMLAttributes<"button"> {
  value: string;
  label?: string;
}

const { value, label = "Copy to clipboard", class: className, ...rest } = Astro.props;
const uid = `tip-${Math.random().toString(36).slice(2, 9)}`;
---

<Tooltip.Root>
  <Tooltip.Trigger>
    <Button
      variant="ghost"
      size="icon-sm"
      class:list={["copybtn", className]}
      data-copybtn
      data-value={value}
      data-copied="false"
      data-tip={uid}
      aria-label={label}
      type="button"
      {...rest}
    >
      <span class="sr-only" aria-live="polite" aria-atomic="true"></span>
      <span class="ic-wrap" aria-hidden="true">
        <Copy class="ic ic-copy" />
        <Check class="ic ic-check" />
      </span>
    </Button>
  </Tooltip.Trigger>
  <Tooltip.Content><span id={uid} data-tip-text>Copy</span></Tooltip.Content>
</Tooltip.Root>

<style>
  .ic-wrap {
    position: relative;
    display: inline-flex;
    width: 15px;
    height: 15px;
  }
  .ic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      filter 300ms ease,
      color 300ms ease;
  }
  .ic-check {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copybtn[data-copied="true"] .ic-copy {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  .copybtn[data-copied="true"] .ic-check {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .ic {
      transition: none;
    }
  }
</style>

<script>
  const copyTimers = new WeakMap<Element, number>();
  const legacyCopy = (value: string) => {
    const ta = document.createElement("textarea");
    ta.value = value;
    ta.setAttribute("readonly", "");
    ta.style.cssText = "position:fixed;opacity:0;pointer-events:none";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, value.length);
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    ta.remove();
    return ok;
  };
  document.addEventListener("click", async (e) => {
    const target = e.target instanceof Element ? e.target : null;
    const btn = target?.closest?.("[data-copybtn]");
    if (!btn) return;
    const value = btn.getAttribute("data-value") ?? "";
    if (!value) return;
    let ok = false;
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        ok = true;
      } catch {
        ok = legacyCopy(value);
      }
    } else {
      ok = legacyCopy(value);
    }
    if (!ok) return;
    const originalLabel = btn.getAttribute("data-orig-label") ?? btn.getAttribute("aria-label") ?? "";
    btn.setAttribute("data-orig-label", originalLabel);
    btn.setAttribute("data-copied", "true");
    btn.setAttribute("aria-label", "Copied to clipboard");
    const live = btn.querySelector(".sr-only");
    if (live) live.textContent = "Copied";
    const tipId = btn.getAttribute("data-tip");
    const tip = tipId ? document.getElementById(tipId) : null;
    if (tip) tip.textContent = "Copied";
    const prev = copyTimers.get(btn);
    if (prev) clearTimeout(prev);
    copyTimers.set(
      btn,
      window.setTimeout(() => {
        btn.setAttribute("data-copied", "false");
        btn.setAttribute("aria-label", originalLabel);
        if (live) live.textContent = "";
        if (tip) tip.textContent = "Copy";
      }, 2000),
    );
  });
</script>
