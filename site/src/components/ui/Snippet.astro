---
import CopyButton from "./CopyButton.astro";

interface SnippetTab {
  label: string;
  code: string;
}

interface Props {
  tabs: SnippetTab[];
  defaultTab?: string;
  prompt?: boolean;
  class?: string;
}

const { tabs, defaultTab, prompt = true, class: className } = Astro.props;
const active = defaultTab ?? tabs[0]?.label ?? "";
const uid = `snip-${Math.random().toString(36).slice(2, 9)}`;
const activeCode = tabs.find((t) => t.label === active)?.code ?? "";
---

<div class:list={["snippet", className]} data-snippet>
  <div class="snippet-head">
    <div class="snippet-tabs" role="tablist" aria-label="Package manager">
      {tabs.map((t) => (
        <button
          class="snippet-tab"
          role="tab"
          type="button"
          id={`${uid}-tab-${t.label}`}
          aria-controls={`${uid}-panel-${t.label}`}
          aria-selected={t.label === active ? "true" : "false"}
          tabindex={t.label === active ? 0 : -1}
          data-tab={t.label}
        >
          {t.label}
        </button>
      ))}
    </div>
    <CopyButton value={activeCode} size="sm" class="snippet-copy" />
  </div>
  {tabs.map((t) => (
    <div
      class="snippet-panel"
      role="tabpanel"
      id={`${uid}-panel-${t.label}`}
      aria-labelledby={`${uid}-tab-${t.label}`}
      hidden={t.label !== active}
      data-panel={t.label}
      data-code={t.code}
    >
      <pre class:list={["snippet-pre", { "has-prompt": prompt }]}><code>{t.code}</code></pre>
    </div>
  ))}
</div>

<style>
  .snippet {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--card);
    text-align: left;
  }
  .snippet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    background: #14161a;
  }
  .snippet-tabs {
    display: flex;
    gap: 4px;
  }
  .snippet-tab {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: 13px;
    padding: 5px 12px;
    border-radius: 7px;
    cursor: pointer;
    transition:
      color var(--t-hover, 200ms) ease,
      background var(--t-hover, 200ms) ease;
  }
  .snippet-tab[aria-selected="true"] {
    background: var(--line);
    color: var(--ink);
  }
  .snippet-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .snippet-copy {
    opacity: 0;
    transition:
      opacity var(--t-hover, 200ms) ease,
      color var(--t-hover, 200ms) ease,
      background var(--t-hover, 200ms) ease;
  }
  .snippet:hover .snippet-copy,
  .snippet:focus-within .snippet-copy {
    opacity: 1;
  }
  .snippet-pre {
    margin: 0;
    padding: 18px 20px;
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 14px;
    color: var(--ink);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #2a2e35 transparent;
  }
  .snippet-pre::-webkit-scrollbar {
    height: 6px;
  }
  .snippet-pre::-webkit-scrollbar-thumb {
    background: #2a2e35;
    border-radius: 3px;
  }
  .snippet-pre::-webkit-scrollbar-track {
    background: transparent;
  }
  .has-prompt code::before {
    content: "$ ";
    color: var(--muted);
  }
  @media (hover: none) {
    .snippet-copy {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-snippet]").forEach((snip) => {
    const tabs = [...snip.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...snip.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const copy = snip.querySelector<HTMLElement>("[data-copybtn]");
    const select = (tab: HTMLElement, focus: boolean) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
      });
      const name = tab.dataset.tab;
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== name;
      });
      const panel = panels.find((p) => p.dataset.panel === name);
      if (copy && panel?.dataset.code) copy.setAttribute("data-value", panel.dataset.code);
      if (focus) tab.focus();
    };
    tabs.forEach((t) => t.addEventListener("click", () => select(t, false)));
    snip.querySelector('[role="tablist"]')?.addEventListener("keydown", (e) => {
      if (!(e instanceof KeyboardEvent) || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
      e.preventDefault();
      const i = tabs.indexOf(document.activeElement as HTMLElement);
      const next =
        e.key === "ArrowRight" ? (i + 1) % tabs.length : (i - 1 + tabs.length) % tabs.length;
      const target = tabs[next];
      if (target) select(target, true);
    });
  });
</script>
