---
import { DitherGlobe } from "astro-dither";
import Card from "../starwind/card";

/** Showcase card: a spinning dithered globe with two network stats. */
const STATS = [
  ["38", "Regions"],
  ["41 ms", "Median latency"],
];
---

<Card.Root class="globe-card" role="article">
  <div class="globe-vis" aria-hidden="true">
    <DitherGlobe lat={18} lon={30} cell={2.5} palette={["transparent", "#0b4f99", "#d6efff"]} sea={0.22} />
  </div>
  <Card.Content class="globe-body">
    <h3>Edge network</h3>
    <dl class="globe-stats">
      {
        STATS.map(([value, label]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </Card.Content>
</Card.Root>

<style>
  .globe-card {
    height: 100%;
    padding: 0;
    gap: 0;
    border-radius: 16px;
    overflow: hidden;
  }
  .globe-vis {
    flex: 1;
    min-height: 300px;
    position: relative;
  }
  .globe-vis :global(dither-surface) {
    position: absolute;
    inset: 24px;
    width: auto;
    height: auto;
  }
  .globe-body {
    padding: 0 24px 24px;
  }
  h3 {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .globe-stats {
    display: flex;
    gap: 32px;
    margin: 12px 0 0;
  }
  .globe-stats dt {
    font-size: 13px;
    color: var(--muted);
  }
  .globe-stats dd {
    margin: 2px 0 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
