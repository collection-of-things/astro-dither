---
import { LOGO_BG, LOGO_HI, LOGO_INK, LOGO_RADIUS, LOGO_TILE, logoCellBox, logoCells } from "../lib/logo";

interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
const cells = logoCells();
---

<svg
  class:list={["logo", className]}
  viewBox={`0 0 ${LOGO_TILE} ${LOGO_TILE}`}
  width={size}
  height={size}
  aria-hidden="true"
>
  <defs>
    <clipPath id="logo-clip"><rect width={LOGO_TILE} height={LOGO_TILE} rx={LOGO_RADIUS} /></clipPath>
  </defs>
  <rect width={LOGO_TILE} height={LOGO_TILE} rx={LOGO_RADIUS} fill={LOGO_BG} />
  <g clip-path="url(#logo-clip)">
    {cells.map((c) => {
      if (!c.lit) return null;
      const box = logoCellBox(c.x, c.y);
      return <rect x={box.x} y={box.y} width={box.size} height={box.size} rx={0.5} fill={c.hi ? LOGO_HI : LOGO_INK} />;
    })}
  </g>
</svg>
