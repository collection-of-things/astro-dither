---
import Menu2 from "@tabler/icons/outline/menu-2.svg";
import SearchIcon from "@tabler/icons/outline/search.svg";
import { REPO_URL } from "../site.ts";
import Logo from "./Logo.astro";
import { Button } from "./starwind/button";
import Dialog from "./starwind/dialog";
import { InputGroup, InputGroupAddon, InputGroupInput } from "./starwind/input-group";
import { Kbd } from "./starwind/kbd";
import Sheet from "./starwind/sheet";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const LINKS = [
  { label: "Docs", href: "/docs" },
  { label: "Components", href: "/docs/components/dither" },
  { label: "Effects", href: "/docs/effects" },
  { label: "Examples", href: "/examples" },
];

function isActive(label: string): boolean {
  if (label === "Components") return path.startsWith("/docs/components");
  if (label === "Effects") return path.startsWith("/docs/effects");
  if (label === "Examples") return path === "/examples" || path === "/shapes";
  if (label === "Docs") {
    return (
      path.startsWith("/docs") &&
      !path.startsWith("/docs/components") &&
      !path.startsWith("/docs/effects")
    );
  }
  return false;
}
---

<header class="site-head">
  <nav class="site-nav" aria-label="Site">
    <a class="brand" href="/">
      <Logo size={22} />
      <span class="brand-name">astro-dither</span>
    </a>
    <div class="links">
      {LINKS.map((l) => (
        <a class:list={["link", { on: isActive(l.label) }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="actions">
      <Button
        variant="outline"
        size="sm"
        class="search-field"
        data-sw-dialog-trigger
        data-sw-dialog-target-id="site-search"
        aria-label="Search docs (Ctrl K)"
      >
        <SearchIcon aria-hidden="true" />
        <span class="search-label">Search</span>
        <Kbd data-kbd>Ctrl K</Kbd>
      </Button>
      <Button variant="ghost" size="icon-sm" class="gitcafe" href={REPO_URL} target="_blank" rel="noreferrer" aria-label="Source on GitHub" title="Source on GitHub">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 3v12" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" /></svg>
      </Button>
      <Button variant="primary" size="sm" href="/docs/installation" class="get-started">Get started</Button>
      <Button
        variant="ghost"
        size="icon-sm"
        class="menu-btn"
        aria-label="Menu"
        data-sw-drawer-trigger
        data-sw-drawer-target-id="site-sheet"
      >
        <Menu2 aria-hidden="true" />
      </Button>
    </div>
  </nav>
</header>

<Sheet.Root id="site-sheet">
  <Sheet.Content side="top" class="site-sheet bg-card">
    <Sheet.Title class="sr-only">Menu</Sheet.Title>
    <nav class="sheet-links" aria-label="Site menu">
      {LINKS.map((l) => (
        <a class:list={[{ on: isActive(l.label) }]} href={l.href} data-sw-drawer-close>{l.label}</a>
      ))}
      <a href={REPO_URL} target="_blank" rel="noreferrer" data-sw-drawer-close>GitHub</a>
      <a href="/docs/installation" data-sw-drawer-close>Get started</a>
      <button class="sheet-search" type="button" data-sw-drawer-close data-sw-dialog-trigger data-sw-dialog-target-id="site-search">
        Search
      </button>
    </nav>
  </Sheet.Content>
</Sheet.Root>

<Dialog.Root id="site-search">
  <Dialog.Content class="search-panel" aria-label="Search docs">
    <Dialog.Title class="sr-only">Search docs</Dialog.Title>
    <InputGroup class="search-box">
      <InputGroupAddon align="inline-start" class="search-ic">
        <SearchIcon aria-hidden="true" />
      </InputGroupAddon>
      <InputGroupInput id="search-input" type="text" placeholder="Search docs" autocomplete="off" spellcheck={false} aria-label="Search docs" />
    </InputGroup>
    <ul id="search-results" role="listbox"></ul>
  </Dialog.Content>
</Dialog.Root>

<style>
  .site-head {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 60px;
    background: #050607;
    border-bottom: 1px solid #15171b;
  }
  .site-nav {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .brand-name {
    font-size: 15px;
    font-weight: 600;
  }
  .links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 28px;
  }
  .link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    color: #8b93a1;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  .link:hover {
    color: #f2f4f7;
  }
  .link.on {
    color: #f2f4f7;
  }
  .link.on::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    margin-left: auto;
  }
  .search-field {
    width: 164px;
    height: 32px;
    justify-content: flex-start;
    gap: 8px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .search-field:hover {
    color: var(--ink);
  }
  .search-field kbd {
    font-family: inherit;
    font-size: 12px;
    color: var(--muted);
    margin-left: auto;
    border: 0;
    background: transparent;
    padding: 0;
  }
  .gitcafe {
    color: #8b93a1;
  }
  .gitcafe:hover {
    color: var(--ink);
  }
  .menu-btn {
    display: none;
  }

  /* Site menu sheet (mobile). */
  :global(.site-sheet) {
    padding: 8px 12px 12px;
    border-bottom: 1px solid var(--line);
    border-radius: 0 0 12px 12px;
  }
  .sheet-links {
    display: flex;
    flex-direction: column;
  }
  .sheet-links a,
  .sheet-search {
    padding: 10px 12px;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    border-radius: 8px;
    border: 0;
    background: transparent;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sheet-links a.on {
    color: var(--accent);
  }
  .sheet-links a:hover,
  .sheet-search:hover {
    background: var(--line);
  }

  /* Search dialog as a command palette. */
  :global(.search-panel) {
    top: 90px;
    margin: 0;
    translate: -50% 0;
    width: min(560px, calc(100% - 24px));
    max-width: 560px;
    padding: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--card);
  }
  :global(.search-panel .search-box) {
    height: 48px;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
  }
  :global(.search-panel .search-ic) {
    padding-left: 16px;
    color: var(--muted);
  }
  :global(#search-input) {
    font-size: 15px;
  }
  :global(#search-results) {
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
  }
  :global(#search-results li a) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
  }
  :global(#search-results li.sel a),
  :global(#search-results li a:hover) {
    background: var(--line);
  }
  :global(#search-results .r-title) {
    font-size: 14px;
    color: var(--ink);
  }
  :global(#search-results .r-title small) {
    color: var(--muted);
    font-weight: 400;
    margin-left: 8px;
    font-size: 12px;
  }
  :global(#search-results .r-desc) {
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .gitcafe,
    .get-started {
      display: none;
    }
    .search-field {
      width: 32px;
      padding: 0;
      justify-content: center;
    }
    .search-field kbd,
    .search-label {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  // Show the right shortcut hint on Mac.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll<HTMLElement>("[data-kbd]").forEach((k) => {
      k.textContent = "⌘K";
    });
  }

  interface SearchEntry {
    title: string;
    section: string;
    desc: string;
    href: string;
  }
  let index: SearchEntry[] | undefined;
  const searchDialog = document.getElementById("site-search");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const list = document.getElementById("search-results");
  let selected = 0;
  let results: SearchEntry[] = [];

  function renderResults(items: SearchEntry[]): void {
    if (!list) return;
    list.innerHTML = items
      .map(
        (r, i) =>
          `<li role="option" class="${i === selected ? "sel" : ""}" data-i="${i}"><a href="${r.href}"><span class="r-title">${r.title}<small>${r.section}</small></span><span class="r-desc">${r.desc}</span></a></li>`,
      )
      .join("");
  }
  function search(q: string): void {
    if (!index) return;
    const words = q.toLowerCase().split(/\s+/).filter(Boolean);
    results =
      words.length === 0
        ? index.slice(0, 12)
        : index.filter((e) => words.every((w) => `${e.title} ${e.section} ${e.desc}`.toLowerCase().includes(w)));
    selected = 0;
    renderResults(results.slice(0, 20));
  }
  const lenisApi = () =>
    (window as { __lenis?: { stop(): void; start(): void } }).__lenis;

  async function onSearchOpen(): Promise<void> {
    input?.focus();
    if (index === undefined) {
      const res = await fetch("/search.json");
      index = (await res.json()) as SearchEntry[];
    }
    if (input) search(input.value);
  }

  // Starwind dialogs/drawers dispatch starwind:open-change from their roots.
  const onOpenChange = (e: Event) => {
    if (!(e instanceof CustomEvent)) return;
    const detail = e.detail as { open?: boolean };
    const root = e.target as HTMLElement;
    if (detail.open) {
      lenisApi()?.stop();
      if (root.id === "site-search") requestAnimationFrame(() => void onSearchOpen());
    } else {
      lenisApi()?.start();
    }
  };
  searchDialog?.addEventListener("starwind:open-change", onOpenChange);
  document.getElementById("site-sheet")?.addEventListener("starwind:open-change", onOpenChange);

  const openSearch = () => {
    document
      .querySelector<HTMLElement>('[data-sw-dialog-trigger][data-sw-dialog-target-id="site-search"]')
      ?.click();
  };
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      openSearch();
    } else if (e.key === "/" && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      openSearch();
    }
  });
  input?.addEventListener("input", () => search(input.value));
  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      selected = Math.max(0, Math.min(results.slice(0, 20).length - 1, selected + (e.key === "ArrowDown" ? 1 : -1)));
      renderResults(results.slice(0, 20));
    } else if (e.key === "Enter") {
      const r = results[selected];
      if (r) location.href = r.href;
    }
  });
  list?.addEventListener("mouseover", (e) => {
    const li = (e.target instanceof Element ? e.target : null)?.closest("li");
    if (li?.dataset.i) {
      selected = Number(li.dataset.i);
      renderResults(results.slice(0, 20));
    }
  });
</script>
