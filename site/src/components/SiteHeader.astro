---
import pkg from "../../../packages/astro-dither/package.json";
import { GITCAFE_URL } from "../site.ts";
import Button from "./ui/Button.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isLanding = path === "/";

const LINKS = [
  { label: "Docs", href: "/docs" },
  { label: "Components", href: "/docs/components/dither" },
  { label: "Effects", href: "/docs/effects" },
  { label: "Engine", href: "/docs/engine/how-it-works" },
  { label: "Examples", href: "/examples" },
];

function isActive(label: string): boolean {
  if (label === "Components") return path.startsWith("/docs/components");
  if (label === "Effects") return path.startsWith("/docs/effects");
  if (label === "Engine") return path.startsWith("/docs/engine");
  if (label === "Examples") return path === "/examples" || path === "/shapes";
  if (label === "Docs") {
    return (
      path.startsWith("/docs") &&
      !path.startsWith("/docs/components") &&
      !path.startsWith("/docs/effects") &&
      !path.startsWith("/docs/engine")
    );
  }
  return false;
}
---

<header class="site-head" data-solid={isLanding ? "0" : "1"} data-landing={isLanding ? "1" : "0"}>
  <nav class="site-nav" aria-label="Site">
    <a class="brand" href="/">
      <Logo size={28} />
      <span class="brand-name">astro-dither</span>
      <span class="ver">v{pkg.version}</span>
    </a>
    <div class="links">
      {LINKS.map((l) => (
        <a class:list={["link", { on: isActive(l.label) }]} data-hide={l.label === "Engine" || l.label === "Examples" ? "1024" : undefined} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="actions">
      <button class="search-field" type="button" data-open-search aria-label="Search docs (Ctrl K)">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sf-text">Search docs&hellip;</span>
        <kbd data-kbd>Ctrl K</kbd>
      </button>
      <a class="gitcafe" href={GITCAFE_URL} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 3v12" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" /></svg>
        <span>git.cafe</span>
      </a>
      <Button variant="primary" size="sm" href="/docs/installation" class="get-started">Get started</Button>
      <button class="menu-btn" type="button" data-open-menu aria-label="Menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </nav>
</header>

<div class="sheet" id="site-sheet" hidden>
  <div class="sheet-back" data-close-menu></div>
  <div class="sheet-panel">
    {LINKS.map((l) => (
      <a class:list={[{ on: isActive(l.label) }]} href={l.href}>{l.label}</a>
    ))}
    <a href={GITCAFE_URL} target="_blank" rel="noreferrer">git.cafe</a>
    <a href="/docs/installation">Get started</a>
    <button class="sheet-search" type="button" data-open-search>Search</button>
  </div>
</div>

<div class="search" id="search" hidden>
  <div class="search-back" data-close-search></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <input id="search-input" type="text" placeholder="Search docs" autocomplete="off" spellcheck="false" />
    <ul id="search-results" role="listbox"></ul>
  </div>
</div>

<style>
  .site-head {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 64px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 200ms ease, border-color 200ms ease;
  }
  .site-head::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 96px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .site-head[data-solid="1"] {
    background: rgba(0, 0, 0, 0.78);
    border-bottom-color: #1c1f24;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-head[data-solid="1"]::before {
    opacity: 0;
  }
  .site-head[data-solid="0"] .site-nav {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-head,
    .site-head::before {
      transition: none;
    }
  }
  .site-nav {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .brand-name {
    font-size: 16px;
    font-weight: 600;
  }
  .ver {
    font-size: 11px;
    color: var(--muted);
    background: #16181c;
    border-radius: 6px;
    padding: 2px 6px;
  }
  .links {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 4px;
    flex: 1;
  }
  .link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    font-size: 15px;
    font-weight: 500;
    color: #a1a8b3;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  .link:hover {
    color: var(--ink);
  }
  .link.on {
    color: var(--ink);
  }
  .link.on::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    margin-left: auto;
  }
  .search-field {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 240px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #0f1012;
    color: var(--muted);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .search-field:hover {
    border-color: #262a31;
  }
  .sf-text {
    flex: 1;
    text-align: left;
  }
  .search-field kbd {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .gitcafe {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 500;
    color: #a1a8b3;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  .gitcafe:hover {
    color: var(--ink);
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .sheet[hidden],
  .search[hidden] {
    display: none;
  }
  .sheet,
  .search {
    position: fixed;
    inset: 0;
    z-index: 100;
  }
  .sheet-back,
  .search-back {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }
  .sheet-panel {
    position: absolute;
    top: 56px;
    left: 0;
    right: 0;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    border-radius: 0 0 12px 12px;
    padding: 8px 12px 12px;
    display: flex;
    flex-direction: column;
  }
  .sheet-panel a,
  .sheet-search {
    padding: 10px 12px;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    border-radius: 8px;
    border: 0;
    background: transparent;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sheet-panel a.on {
    color: var(--accent);
  }
  .sheet-panel a:hover,
  .sheet-search:hover {
    background: var(--line);
  }
  .search-panel {
    position: absolute;
    top: 90px;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, calc(100% - 24px));
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  #search-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    outline: none;
  }
  #search-results {
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
  }
  #search-results li a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
  }
  #search-results li.sel a,
  #search-results li a:hover {
    background: var(--line);
  }
  #search-results .r-title {
    font-size: 14px;
    color: var(--ink);
  }
  #search-results .r-title small {
    color: var(--muted);
    font-weight: 400;
    margin-left: 8px;
    font-size: 12px;
  }
  #search-results .r-desc {
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .link[data-hide="1024"] {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .site-head {
      height: 56px;
    }
    .site-nav {
      gap: 0;
    }
    .links,
    .gitcafe,
    .get-started {
      display: none;
    }
    .search-field {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
    .sf-text,
    .search-field kbd {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  // Solid background after a little scroll; always solid off the landing page.
  const head = document.querySelector<HTMLElement>(".site-head");
  const setSolid = () => {
    if (!head) return;
    const landing = head.dataset.landing === "1";
    head.dataset.solid = !landing || scrollY > 16 ? "1" : "0";
  };
  addEventListener("scroll", setSolid, { passive: true });
  setSolid();

  // Show the right shortcut hint on Mac.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll<HTMLElement>("[data-kbd]").forEach((k) => {
      k.textContent = "⌘K";
    });
  }

  interface SearchEntry {
    title: string;
    section: string;
    desc: string;
    href: string;
  }
  let index: SearchEntry[] | undefined;
  const dialog = document.getElementById("search");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const list = document.getElementById("search-results");
  let selected = 0;
  let results: SearchEntry[] = [];

  function renderResults(items: SearchEntry[]): void {
    if (!list) return;
    list.innerHTML = items
      .map(
        (r, i) =>
          `<li role="option" class="${i === selected ? "sel" : ""}" data-i="${i}"><a href="${r.href}"><span class="r-title">${r.title}<small>${r.section}</small></span><span class="r-desc">${r.desc}</span></a></li>`,
      )
      .join("");
  }
  function search(q: string): void {
    if (!index) return;
    const words = q.toLowerCase().split(/\s+/).filter(Boolean);
    results =
      words.length === 0
        ? index.slice(0, 12)
        : index.filter((e) => words.every((w) => `${e.title} ${e.section} ${e.desc}`.toLowerCase().includes(w)));
    selected = 0;
    renderResults(results.slice(0, 20));
  }
  async function openSearch(): Promise<void> {
    dialog?.removeAttribute("hidden");
    document.getElementById("site-sheet")?.setAttribute("hidden", "");
    input?.focus();
    if (index === undefined) {
      const res = await fetch("/search.json");
      index = (await res.json()) as SearchEntry[];
    }
    if (input) search(input.value);
  }
  function closeSearch(): void {
    dialog?.setAttribute("hidden", "");
  }

  document.querySelectorAll("[data-open-search]").forEach((b) => b.addEventListener("click", () => void openSearch()));
  document.querySelectorAll("[data-close-search]").forEach((b) => b.addEventListener("click", closeSearch));
  document.querySelector("[data-open-menu]")?.addEventListener("click", () =>
    document.getElementById("site-sheet")?.removeAttribute("hidden"),
  );
  document.querySelectorAll("[data-close-menu], .sheet-panel a").forEach((b) =>
    b.addEventListener("click", () => document.getElementById("site-sheet")?.setAttribute("hidden", "")),
  );

  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      void openSearch();
    } else if (e.key === "/" && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      void openSearch();
    } else if (e.key === "Escape") {
      closeSearch();
      document.getElementById("site-sheet")?.setAttribute("hidden", "");
    }
  });
  input?.addEventListener("input", () => search(input.value));
  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      selected = Math.max(0, Math.min(results.slice(0, 20).length - 1, selected + (e.key === "ArrowDown" ? 1 : -1)));
      renderResults(results.slice(0, 20));
    } else if (e.key === "Enter") {
      const r = results[selected];
      if (r) location.href = r.href;
    }
  });
  list?.addEventListener("mouseover", (e) => {
    const li = (e.target instanceof Element ? e.target : null)?.closest("li");
    if (li?.dataset.i) {
      selected = Number(li.dataset.i);
      renderResults(results.slice(0, 20));
    }
  });
</script>
