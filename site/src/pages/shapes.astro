---
import Base from "../layouts/Base.astro";
import { Dither, ditherPresets } from "astro-dither";

const variants = ditherPresets.filter((preset) => preset.name !== "Sphere");
---

<Base title="astro-dither - shapes">
  <main>
    <header class="head">
      <h1>Shapes</h1>
      <p class="lede">
        The <code>Dither</code> component draws Paper's animated shapes. These are its presets, exported as <code>ditherPresets</code>.
      </p>
    </header>
    <div class="hero">
      <Dither />
    </div>
    <section class="variants">
      {
        variants.map((preset) => (
          <figure>
            <div class="frame">
              <Dither {...preset.params} />
            </div>
            <figcaption>{preset.name}</figcaption>
          </figure>
        ))
      }
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 1320px;
    margin: 0 auto;
    padding: calc(var(--header-offset) + 56px) var(--margin) 96px;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
  }

  .lede {
    max-width: 56ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .lede code {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.9em;
    color: var(--ink);
  }

  .hero {
    height: min(52vh, 460px);
    margin-top: 40px;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px 16px;
    margin-top: 16px;
  }

  figure {
    margin: 0;
    min-width: 0;
  }

  .frame {
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }

  figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    main {
      padding-top: calc(var(--header-offset) + 32px);
    }
    .variants {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 10px;
    }
  }
</style>
