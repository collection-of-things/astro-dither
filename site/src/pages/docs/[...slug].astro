---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const href = entry.id === "index" ? "/docs" : `/docs/${entry.id}`;
const md = entry.id === "index" ? "/docs.md" : `/docs/${entry.id}.md`;
---

<DocsLayout title={entry.data.title} description={entry.data.description} href={href} md={md} toc={toc}>
  <Content />
</DocsLayout>
