---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import DocsDemo from "../../../components/docs/DocsDemo.astro";
import InstallSnippet from "../../../components/ui/InstallSnippet.astro";
import Table from "../../../components/starwind/table";
import { Code } from "astro-expressive-code/components";
import { DitherEffect, DitherGlobe } from "astro-dither";
import { effects } from "astro-dither/effects";
import type { EffectDefinition } from "astro-dither/effects";
import { EFFECTS, effectParamRows, SHARED_PROP_ROWS } from "../../../docs/registry";
import { inline, usageImport } from "../../../docs/format";
import { effectControls } from "../../../docs/components";

export function getStaticPaths() {
  return EFFECTS.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const def: EffectDefinition = effects[doc.slug];
const href = `/docs/effects/${doc.slug}`;

const seed: Record<string, unknown> = {
  effect: doc.slug,
  params: { ...def.params },
  palette: [...def.palette],
  cell: 2,
  matrix: 8,
  speed: def.speed,
};

const paramControls = effectControls(doc.slug);

const exampleSeed = (ex: (typeof doc.examples)[number]) => {
  const s: Record<string, unknown> = { ...seed, params: { ...def.params, ...ex.params } };
  if (ex.palette) s.palette = [...ex.palette];
  if (ex.cell !== undefined) s.cell = ex.cell;
  if (ex.matrix !== undefined) s.matrix = ex.matrix;
  if (ex.speed !== undefined) s.speed = ex.speed;
  return s;
};

const toc = [
  { slug: "preview", text: "Preview", depth: 2 },
  { slug: "installation", text: "Installation", depth: 2 },
  { slug: "usage", text: "Usage", depth: 2 },
  { slug: "examples", text: "Examples", depth: 2 },
  { slug: "props", text: "Props", depth: 2 },
  { slug: "notes", text: "Notes", depth: 2 },
];

const propRows = [...effectParamRows(doc.slug), ...SHARED_PROP_ROWS];
---

<DocsLayout title={doc.title} description={doc.description} href={href} toc={toc}>
  <h2 id="preview">Preview</h2>
  <DocsDemo
    element="dither-surface"
    seed={seed}
    tpl="<DitherEffect {props} />"
    controls={paramControls}
    palettes
    matrix
    cell
    speed
    animate
    extras
  >
    {doc.slug === "globe" ? <DitherGlobe /> : <DitherEffect effect={doc.slug} />}
  </DocsDemo>

  <h2 id="installation">Installation</h2>
  <InstallSnippet />
  <p class="alt-install">Or copy the source into your project:</p>
  <Code code="npx astro-dither add effect" lang="bash" frame="terminal" />

  <h2 id="usage">Usage</h2>
  <Code
    code={`---\nimport { ${usageImport(doc.usage)} } from "astro-dither";\n---\n\n${doc.usage}`}
    lang="astro"
    frame="code"
    title="src/pages/index.astro"
  />
  <p set:html={inline(doc.intro)}></p>
  <p>The props group like this:</p>
  <p set:html={inline(doc.propGroups)}></p>

  <h2 id="examples">Examples</h2>
  {
    doc.examples.map((ex) => (
      <>
        <h3>{ex.title}</h3>
        <p set:html={inline(ex.sentence)}></p>
        <DocsDemo
          element="dither-surface"
          seed={exampleSeed(ex)}
          tpl="<DitherEffect {props} />"
        >
          <dither-surface data-dither={JSON.stringify(exampleSeed(ex))} aria-hidden="true" />
        </DocsDemo>
      </>
    ))
  }

  <h2 id="props">Props</h2>
  <Table.Root>
    <Table.Header>
      <Table.Row>
        <Table.Head>Prop</Table.Head>
        <Table.Head>Type</Table.Head>
        <Table.Head>Default</Table.Head>
        <Table.Head>Description</Table.Head>
      </Table.Row>
    </Table.Header>
    <Table.Body>
      {propRows.map((r) => (
        <Table.Row>
          <Table.Cell><code>{r.name}</code></Table.Cell>
          <Table.Cell><code>{r.type}</code></Table.Cell>
          <Table.Cell>{r.def}</Table.Cell>
          <Table.Cell set:html={inline(r.desc)} />
        </Table.Row>
      ))}
    </Table.Body>
  </Table.Root>

  <h2 id="notes">Notes</h2>
  <ul>
    <li>Decorative and <code>aria-hidden</code>. Put real text on top of it, not inside it.</li>
    <li>With reduced motion it draws one still frame at {def.stillTime}s and stops.</li>
    <li>It pauses when scrolled out of view or when the tab is hidden.</li>
    <li>It shares one WebGL context with every other ordered effect on the page.</li>
  </ul>
</DocsLayout>

<style>
  .alt-install {
    margin: 0 0 10px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
