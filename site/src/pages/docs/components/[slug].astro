---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import DocsDemo from "../../../components/docs/DocsDemo.astro";
import Snippet from "../../../components/ui/Snippet.astro";
import CopyButton from "../../../components/ui/CopyButton.astro";
import { Code } from "astro:components";
import { Dither, DitherImage, DitherGradient, DitherAurora, DitherEffect, DitherGlobe } from "astro-dither";
import { COMPONENT_DOCS } from "../../../docs/components";
import { inline } from "../../../docs/format";

export function getStaticPaths() {
  return COMPONENT_DOCS.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const href = `/docs/components/${doc.slug}`;
const cliName = doc.slug.replace("dither-", "");

const toc = [
  { slug: "preview", text: "Preview", depth: 2 },
  { slug: "installation", text: "Installation", depth: 2 },
  { slug: "usage", text: "Usage", depth: 2 },
  { slug: "props", text: "Props", depth: 2 },
  { slug: "notes", text: "Notes", depth: 2 },
];
---

<DocsLayout title={doc.title} description={doc.description} href={href} toc={toc}>
  <h2 id="preview">Preview</h2>
  <DocsDemo
    element={doc.element}
    seed={doc.seed}
    tpl={`<${doc.component} {props} />`}
    controls={doc.controls}
    imgHtml={doc.slug === "dither-image" ? '<img src="/examples/portrait.jpg" alt="A dithered portrait" crossorigin="anonymous" decoding="async" />' : ""}
  >
    {
      doc.slug === "dither" ? (
        <Dither />
      ) : doc.slug === "dither-image" ? (
        <DitherImage src="/examples/portrait.jpg" alt="A dithered portrait" colorFront="#00b2ff" colorHighlight="#d6efff" />
      ) : doc.slug === "dither-gradient" ? (
        <DitherGradient />
      ) : doc.slug === "dither-aurora" ? (
        <DitherAurora />
      ) : doc.slug === "dither-globe" ? (
        <DitherGlobe />
      ) : (
        <DitherEffect effect="plasma" />
      )
    }
  </DocsDemo>

  <h2 id="installation">Installation</h2>
  <Snippet
    tabs={[
      { label: "pnpm", code: "pnpm add astro-dither" },
      { label: "npm", code: "npm i astro-dither" },
      { label: "bun", code: "bun add astro-dither" },
    ]}
    defaultTab="pnpm"
  />
  <p class="alt-install">
    Or copy the source into your project: <code>npx astro-dither add {cliName}</code>
    <CopyButton value={`npx astro-dither add ${cliName}`} size="sm" label="Copy source command" />
  </p>

  <h2 id="usage">Usage</h2>
  <Code code={`---\nimport { ${doc.component} } from "astro-dither";\n---\n\n${doc.usage}`} lang="astro" theme="github-dark-dimmed" />
  <p set:html={inline(doc.intro)}></p>

  <h2 id="props">Props</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        {doc.rows.map((r) => (
          <tr>
            <td><code>{r.name}</code></td>
            <td><code>{r.type}</code></td>
            <td>{r.def}</td>
            <td set:html={inline(r.desc)}></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="notes">Notes</h2>
  <ul>
    <li>Decorative surfaces render <code>aria-hidden</code>. Put real text on top, not inside them.</li>
    <li>With reduced motion it draws one still frame and stops.</li>
    <li>It pauses when scrolled out of view or when the tab is hidden.</li>
  </ul>
</DocsLayout>

<style>
  .alt-install {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  .alt-install code {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 13px;
    color: var(--ink);
  }
</style>
