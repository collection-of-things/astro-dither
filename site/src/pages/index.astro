---
import Base from "../layouts/Base.astro";
import { DitherAurora, DitherEffect, DitherImage } from "astro-dither";
import { Code } from "astro-expressive-code/components";
import Logo from "../components/Logo.astro";
import CopyButton from "../components/ui/CopyButton.astro";
import InstallSnippet from "../components/ui/InstallSnippet.astro";
import { Badge } from "../components/starwind/badge";
import { Button } from "../components/starwind/button";
import Card from "../components/starwind/card";
import { InputGroup, InputGroupAddon, InputGroupInput } from "../components/starwind/input-group";
import { ToggleGroup, ToggleGroupItem } from "../components/starwind/toggle-group";
import GlobeCard from "../components/showcase/GlobeCard.astro";
import PlayerCard from "../components/showcase/PlayerCard.astro";
import PlanCard from "../components/showcase/PlanCard.astro";
import { REPO_URL, PAPER_URL } from "../site.ts";

const INSTALL = {
  pnpm: "pnpm add astro-dither",
  npm: "npm i astro-dither",
  bun: "bun add astro-dither",
};

interface UsageItem {
  label: string;
  el: "dither-surface" | "dither-image";
  data: Record<string, unknown>;
  img?: string;
  code: string;
}

const USAGE_ITEMS: UsageItem[] = [
  {
    label: "Aurora",
    el: "dither-surface",
    data: { effect: "aurora" },
    code: '---\nimport { DitherAurora } from "astro-dither";\n---\n\n<DitherAurora />',
  },
  {
    label: "Mesh",
    el: "dither-surface",
    data: { effect: "mesh" },
    code: '---\nimport { DitherEffect } from "astro-dither";\n---\n\n<DitherEffect effect="mesh" />',
  },
  {
    label: "Image",
    el: "dither-image",
    data: { colorFront: "#00b2ff", colorHighlight: "#d6efff" },
    img: '<img src="/examples/landscape.jpg" alt="A dithered landscape" crossorigin="anonymous" decoding="async" />',
    code: '---\nimport { DitherImage } from "astro-dither";\n---\n\n<DitherImage\n  src="/examples/landscape.jpg"\n  alt="A dithered landscape"\n/>',
  },
];

const WHY_TILES: Record<string, unknown>[] = [
  { effect: "gradient" },
  { effect: "glow" },
  { effect: "mesh" },
  { effect: "plasma" },
  { effect: "noise" },
  { effect: "silk" },
  { effect: "smoke" },
  { effect: "contours" },
  { effect: "ripples" },
  { effect: "metaballs" },
  { effect: "tunnel" },
  { effect: "starfield" },
];

const STRIP = [
  {
    name: "Aurora",
    slug: "aurora",
    data: { effect: "aurora" },
    code: "<DitherAurora />",
  },
  { name: "Plasma", slug: "plasma", data: { effect: "plasma" }, code: '<DitherEffect effect="plasma" />' },
  { name: "Waves", slug: "waves", data: { effect: "waves" }, code: '<DitherEffect effect="waves" />' },
  { name: "Contours", slug: "contours", data: { effect: "contours" }, code: '<DitherEffect effect="contours" />' },
  { name: "Tunnel", slug: "tunnel", data: { effect: "tunnel" }, code: '<DitherEffect effect="tunnel" />' },
  { name: "Retro grid", slug: "retro-grid", data: { effect: "retro-grid" }, code: '<DitherEffect effect="retro-grid" />' },
  { name: "Smoke", slug: "smoke", data: { effect: "smoke" }, code: '<DitherEffect effect="smoke" />' },
  { name: "Starfield", slug: "starfield", data: { effect: "starfield" }, code: '<DitherEffect effect="starfield" />' },
];

const INSTALL_LINKS = [
  ["View on npm", "https://www.npmjs.com/package/astro-dither"],
  ["Installation guide", "/docs/installation"],
  ["Components", "/docs/components/dither"],
  ["Write your own effect", "/docs/engine/write-your-own"],
];

const FOOTER_RISE = {
  effect: "rise",
  params: { height: 0.75, wave: 0.05, grain: 0.35 },
  palette: ["#000000", "#020812", "#05173a", "#0a2a66", "#0f3f94", "#1a5bc4"],
  cell: 4,
  speed: 0.5,
};
---

<Base title="astro-dither: Dither for Astro">
  <header class="hero">
    <div class="hero-sky" aria-hidden="true"><DitherEffect effect="starfield" params={{ gain: 0.7 }} /></div>
    <div class="hero-aurora" aria-hidden="true">
      <DitherAurora
        color="#3d8bff"
        tipColor="#6a4cff"
        background="transparent"
        height={0.66}
        curtains={3}
        spread={0.08}
        rays={9}
        length={0.5}
        sway={1.1}
        glow={1}
        intensity={0.7}
        cell={3}
        bloom={0.55}
        bloomRadius={14}
      />
    </div>
    <div class="hero-inner">
      <h1 class="lines" aria-label="Animated dither for Astro">
        <span class="line"><span data-line style="--i:0">Animated dither</span></span>
        <span class="line"><span data-line style="--i:1">for Astro</span></span>
      </h1>
      <p class="sub" data-fade style="--d:350ms">
        Backgrounds, gradients and image effects.<br />
        Plain Astro components. No React.
      </p>
      <div class="hero-actions" data-fade style="--d:500ms">
        <Button variant="primary" href="/docs/installation">Get started</Button>
        <InputGroup class="cmd-pill">
          <InputGroupInput readonly value={INSTALL.pnpm} aria-label="Install command" tabindex={-1} />
          <InputGroupAddon align="inline-end">
            <CopyButton value={INSTALL.pnpm} label="Copy install command" />
          </InputGroupAddon>
        </InputGroup>
      </div>
    </div>
  </header>

  <main class="container">
    {/* A. Write this, get this */}
    <section class="section" id="usage" data-enter style="--i:0">
      <div class="sec-head">
        <h2>Write this, get this.</h2>
        <div class="sec-side">
          <p>Every effect is one Astro component. This is the whole setup.</p>
        </div>
      </div>
      <ToggleGroup
        spacing={0}
        class="usage-chips"
        defaultValue={["0"]}
        aria-label="Usage example"
        id="usage-chips"
      >
        {USAGE_ITEMS.map((u, i) => (
          <ToggleGroupItem
            value={String(i)}
            class="usage-chip"
            data-el={u.el}
            data-dd={JSON.stringify(u.data)}
            data-img={u.img ?? ""}
          >
            {u.label}
          </ToggleGroupItem>
        ))}
      </ToggleGroup>
      <div class="usage-row">
        <div class="usage-code">
          {USAGE_ITEMS.map((u, i) => (
            <div class:list={["uc", { on: i === 0 }]} data-uc={i}>
              <Code code={u.code} lang="astro" frame="code" title="src/pages/index.astro" />
            </div>
          ))}
        </div>
        <Card.Root class="usage-live" id="usage-live">
          <DitherAurora />
        </Card.Root>
      </div>
      <div hidden aria-hidden="true">
        <DitherImage src="/examples/landscape.jpg" alt="" />
      </div>
    </section>

    {/* B. Effects filmstrip */}
    <section class="section" id="effects" data-enter style="--i:0">
      <div class="sec-head">
        <h2>Nineteen effects, one engine.</h2>
        <div class="sec-side strip-side">
          <a class="more" href="/docs/effects">Browse all effects</a>
          <span class="strip-arrows">
            <Button variant="outline" size="icon-sm" class="strip-btn" data-strip="-1" aria-label="Previous effects" disabled>&larr;</Button>
            <Button variant="outline" size="icon-sm" class="strip-btn" data-strip="1" aria-label="Next effects">&rarr;</Button>
          </span>
        </div>
      </div>
      <div class="strip" id="strip">
          {STRIP.map((s) => (
            <a class="strip-item" href={`/docs/effects/${s.slug}`}>
              <span class="strip-vis">
                <dither-surface data-dither={JSON.stringify({ ...s.data, bloom: 0.55, bloomRadius: 12 })} aria-hidden="true" />
              </span>
              <span class="strip-name">{s.name}</span>
              <code class="strip-code">{s.code}</code>
            </a>
          ))}
        </div>
    </section>

    {/* Showcase: everyday UI built from the components */}
    <section class="section" id="showcase" data-enter style="--i:0">
      <div class="sec-head">
        <h2>Use it in real UI.</h2>
        <div class="sec-side">
          <p>Cards, players and buttons built from the same components.</p>
        </div>
      </div>
      <div class="showcase-grid">
        <GlobeCard />
        <PlayerCard />
        <PlanCard />
      </div>
    </section>

    {/* C. Why astro-dither */}
    <section class="section" id="why" data-enter style="--i:0">
      <div class="sec-head">
        <h2>Made for Astro pages.</h2>
        <div class="sec-side">
          <p>Small, fast and accessible by default.</p>
        </div>
      </div>
      <div class="why-grid">
        <Card.Root class="why-card">
          <div class="why-vis why-js">
            <div class="why-js-rows">
              <span class="why-js-line"><span class="why-js-k">Initial JS</span><span class="why-js-v">206.1 kB, 70.1 kB gzipped</span></span>
              <span class="why-js-line"><span class="why-js-k">React</span><span class="why-js-v dim">not installed</span></span>
              <span class="why-js-line"><span class="why-js-k">Hydration</span><span class="why-js-v dim">custom elements, no framework</span></span>
            </div>
          </div>
          <Card.Content class="why-body">
            <h3>No React dependency.</h3>
            <p>Initial home scripts and static imports, including shared UI. Excludes lazy chunks loaded later.</p>
          </Card.Content>
        </Card.Root>
        <Card.Root class="why-card">
          <div class="why-vis">
            <div class="why-tiles">
              {WHY_TILES.map((t) => (
                <dither-surface data-dither={JSON.stringify({ ...t, bloom: 0.5, bloomRadius: 6 })} aria-hidden="true" />
              ))}
            </div>
            <Badge tone="neutral" appearance="frosted" size="sm" class="why-badge">12 surfaces · 1 WebGL context</Badge>
          </div>
          <Card.Content class="why-body">
            <h3>Many effects, one context.</h3>
            <p>Every effect on a page shares one WebGL context, so a page can hold dozens.</p>
          </Card.Content>
        </Card.Root>
        <Card.Root class="why-card">
          <div class="why-vis">
            <dither-surface data-dither='{"effect":"aurora","speed":0}' aria-hidden="true" />
            <span class="why-chips">
              <Badge tone="neutral" appearance="frosted" size="sm" class="why-chip">aria-hidden</Badge>
              <Badge tone="neutral" appearance="frosted" size="sm" class="why-chip">Reduced motion</Badge>
              <Badge tone="neutral" appearance="frosted" size="sm" class="why-chip">Pauses offscreen</Badge>
            </span>
          </div>
          <Card.Content class="why-body">
            <h3>Accessible by default.</h3>
            <p>Backgrounds stay out of screen readers, hold still for reduced motion and stop drawing when offscreen.</p>
          </Card.Content>
        </Card.Root>
      </div>
    </section>

    {/* D. Install band */}
    <section class="section" id="install" data-enter style="--i:0">
      <Card.Root class="install-band">
        <div class="install-col">
          <h2>Install</h2>
          <p>Astro 5 or newer. One dependency: Paper Shaders.</p>
        </div>
        <div class="install-col install-mid">
          <InstallSnippet />
        </div>
        <div class="install-col">
          <p class="install-own">Prefer owning the code?</p>
          <Code code="npx astro-dither add aurora" lang="bash" frame="terminal" />
          <a class="install-doc" href="/docs/copy-the-source">Read the CLI docs</a>
        </div>
      </Card.Root>
      <div class="install-links">
        {INSTALL_LINKS.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a class="nav-brand" href="/">
          <Logo size={16} />
          <span>astro-dither</span>
        </a>
        <p>Dither components for Astro. MIT licensed.</p>
        <p class="credit">Inspired by <a href="https://dithercn.vercel.app">dithercn</a> by Leo.</p>
        <p class="credit">
          Buttons and snippets adapted from <a href="https://starwind.dev">Starwind UI</a>, <a href="https://www.cult-ui.com">Cult UI</a> and <a href="https://www.kibo-ui.com">Kibo UI</a>.
        </p>
        <a class="more" href={REPO_URL}>Source &rsaquo;</a>
      </div>
      <div class="footer-links">
        <div class="fl-col">
          <p class="fl-head">Get started</p>
          <a href="#install">Install</a>
          <a href={REPO_URL}>README</a>
        </div>
        <div class="fl-col">
          <p class="fl-head">Examples</p>
          <a href="/examples">All effects</a>
          <a href="/shapes">Shapes</a>
        </div>
        <div class="fl-col">
          <p class="fl-head">Project</p>
          <a href={REPO_URL}>Source</a>
          <a href={PAPER_URL}>Paper Shaders</a>
          <a href="/licenses">Third-party licenses</a>
        </div>
      </div>
    </div>
    <div class="footer-band">
      <dither-surface data-dither={JSON.stringify(FOOTER_RISE)} aria-hidden="true" />
      <div class="container band-inner">
        <p class="band-word" aria-hidden="true">astro-dither</p>
        <div class="band-row">
          <span>&copy; 2026 astro-dither &middot; MIT</span>
          <a href="#top" data-top>Back to top &uarr;</a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    .container {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 var(--margin);
    }

    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      height: 100svh;
      min-height: 560px;
      padding-top: 60px;
      display: grid;
      place-items: center;
      text-align: center;
      overflow: hidden;
    }
    .hero-sky {
      position: absolute;
      inset: 0;
    }
    .hero-aurora {
      position: absolute;
      inset: 0;
    }
    .hero-sky dither-surface,
    .hero-aurora dither-surface {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .hero-inner {
      position: relative;
      z-index: 2;
      padding: 0 var(--margin);
    }
    .hero:has(:global(dither-surface[data-dither-fallback]))::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: #000b;
      pointer-events: none;
    }
    .hero h1 {
      font-size: clamp(2.75rem, 8vw, 6.5rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 0.98;
      color: var(--ink);
      text-shadow: 0 2px 32px rgba(0, 0, 0, 0.6);
    }
    .sub {
      margin-top: 22px;
      font-size: 16px;
      line-height: 1.6;
      color: var(--muted);
    }
    .hero-actions {
      margin-top: 32px;
      display: flex;
      gap: 12px;
      justify-content: center;
      align-items: center;
    }
    /* Command pill: an InputGroup field holding the install command + copy. */
    .cmd-pill {
      width: auto;
      height: 44px;
      border-radius: 999px;
      border-color: var(--line);
      background: var(--card);
      padding-left: 12px;
    }
    .cmd-pill :global(input) {
      font-family: "Geist Mono", ui-monospace, monospace;
      font-size: 14px;
      color: var(--ink);
    }

    /* ---------- Sections ---------- */
    .section {
      padding-top: 120px;
    }
    .sec-head {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: end;
      margin-bottom: 44px;
    }
    h2 {
      font-size: var(--step-head);
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--ink);
    }
    .sec-side p {
      font-size: var(--step-body);
      line-height: 1.6;
      color: var(--muted);
      max-width: 46ch;
      margin-left: auto;
    }
    .more {
      display: inline-block;
      margin-top: 12px;
      font-size: 14px;
      color: var(--muted);
      text-decoration: none;
      margin-left: auto;
      text-align: right;
      width: 100%;
      max-width: 46ch;
    }
    .more:hover {
      color: var(--accent);
    }

    /* ---------- A. Write this, get this ---------- */
    .usage-chips {
      display: flex;
      width: fit-content;
      gap: 8px;
      margin-bottom: 16px;
    }
    .usage-chip {
      height: 32px;
      padding: 0 16px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      font-family: inherit;
      font-size: 13px;
      cursor: pointer;
      transition: color var(--t-hover) ease, border-color var(--t-hover) ease;
    }
    .usage-chip:hover {
      color: var(--ink);
      border-color: #262a31;
    }
    .usage-chip[data-state="on"] {
      background: var(--accent);
      color: var(--on-accent);
    }
    .usage-row {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 16px;
      align-items: stretch;
    }
    .usage-code {
      min-width: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .usage-code .uc {
      display: none;
    }
    .usage-code .uc.on {
      display: block;
      flex: 1;
    }
    .usage-code :global(.expressive-code) {
      height: 100%;
      margin: 0;
    }
    .usage-live {
      position: relative;
      aspect-ratio: 4 / 3;
      padding: 0;
      gap: 0;
      overflow: hidden;
      border-radius: 16px;
    }
    :global(.usage-live > *) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    :global(.usage-live dither-image > img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ---------- B. Effects filmstrip ---------- */
    .strip-side {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
    }
    .strip-side .more {
      margin: 0;
      width: auto;
      text-align: right;
    }
    .strip-arrows {
      display: inline-flex;
      gap: 4px;
    }
    .strip-btn {
      width: 32px;
      height: 32px;
      font-size: 14px;
    }
    .strip-btn:disabled {
      opacity: 0.3;
    }
    .strip {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .strip::-webkit-scrollbar {
      display: none;
    }
    .strip-item {
      flex: none;
      width: calc((100% - 48px) / 4);
      scroll-snap-align: start;
      text-decoration: none;
    }
    .strip-vis {
      display: block;
      position: relative;
      aspect-ratio: 3 / 4;
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      background: var(--card);
      transition: border-color var(--t-hover) ease;
    }
    .strip-item:hover .strip-vis {
      border-color: #262a31;
    }
    /* The surfaces bloom brighter on hover through the bloom's CSS variables. */
    .strip-item:hover dither-surface,
    .strip-item:focus-visible dither-surface {
      --dither-bloom: 1;
    }
    .strip-vis dither-surface {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .strip-name {
      display: block;
      margin-top: 12px;
      font-size: 15px;
      font-weight: 500;
      color: var(--ink);
    }
    .strip-code {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      margin-top: 4px;
      font-family: "Geist Mono", ui-monospace, monospace;
      font-size: 13px;
      line-height: 1.5;
      color: var(--muted);
      overflow: hidden;
    }

    /* ---------- Showcase ---------- */
    .showcase-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 16px;
      align-items: stretch;
    }

    /* ---------- C. Why astro-dither ---------- */
    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      align-items: stretch;
    }
    .why-vis {
      position: relative;
      aspect-ratio: 16 / 10;
      border-bottom: 1px solid var(--line);
      overflow: hidden;
      background: #050607;
    }
    .why-vis > dither-surface {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .why-tiles {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(3, 1fr);
      gap: 4px;
      padding: 4px;
    }
    .why-tiles dither-surface {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      border-radius: 4px;
      overflow: hidden;
    }
    .why-card {
      padding: 0;
      gap: 0;
      overflow: hidden;
      border-radius: 16px;
    }
    .why-badge {
      position: absolute;
      right: 8px;
      bottom: 8px;
      font-size: 11px;
      font-family: "Geist Mono", ui-monospace, monospace;
      font-weight: 400;
    }
    .why-chips {
      position: absolute;
      left: 8px;
      bottom: 8px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .why-chip {
      font-size: 11px;
      font-family: "Geist Mono", ui-monospace, monospace;
      font-weight: 400;
    }
    .why-js {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .why-js-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      font-family: "Geist Mono", ui-monospace, monospace;
      font-size: 13px;
    }
    .why-js-line {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line);
    }
    .why-js-line:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
    .why-js-k {
      color: var(--muted);
    }
    .why-js-v {
      color: var(--accent);
      text-align: right;
    }
    .why-js-v.dim {
      color: var(--ink);
    }
    .why-body {
      padding: 16px 20px 20px;
    }
    .why-body h3 {
      font-size: 15px;
      font-weight: 500;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .why-body p {
      font-size: 13px;
      line-height: 1.6;
      color: var(--muted);
    }

    /* ---------- D. Install band ---------- */
    .install-band {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr;
      gap: 40px;
      padding: 40px;
      border-radius: 16px;
    }
    .install-col h2 {
      font-size: 26px;
    }
    .install-col > p {
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
    }
    .install-own {
      font-size: 14px;
      color: var(--ink);
      font-weight: 500;
      margin-bottom: 10px;
    }
    .install-band :global(.expressive-code) {
      margin: 0;
    }
    .install-doc {
      display: inline-block;
      margin-top: 12px;
      font-size: 14px;
      color: var(--muted);
      text-decoration: none;
    }
    .install-doc:hover {
      color: var(--ink);
    }
    .install-links {
      display: flex;
      gap: 32px;
      justify-content: center;
      margin-top: 28px;
      padding-bottom: 120px;
      font-size: 14px;
    }
    .install-links a {
      color: var(--muted);
      text-decoration: none;
      transition: color var(--t-hover) ease;
    }
    .install-links a:hover {
      color: var(--ink);
    }

    /* ---------- Footer ---------- */
    .footer {
      border-top: 1px solid var(--line);
      margin-top: 0;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 48px;
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .nav-brand {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }
    .footer-brand p {
      margin-top: 14px;
      font-size: 14px;
      color: var(--muted);
      max-width: 28ch;
    }
    .footer-brand .more {
      margin-top: 14px;
      margin-left: 0;
      text-align: left;
    }
    .credit a {
      color: var(--ink);
      text-decoration: none;
    }
    .credit a:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    .footer-links {
      display: flex;
      gap: 72px;
    }
    .fl-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 14px;
    }
    .fl-head {
      color: var(--ink);
      font-weight: 500;
      margin-bottom: 4px;
    }
    .fl-col a {
      color: var(--muted);
      text-decoration: none;
      transition: color var(--t-hover) ease;
    }
    .fl-col a:hover {
      color: var(--ink);
    }
    .footer-band {
      position: relative;
      height: 440px;
      margin-top: 64px;
      overflow: hidden;
    }
    .footer-band > dither-surface {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .band-inner {
      position: relative;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 24px;
    }
    .band-word {
      margin: 0 0 14px;
      font-size: clamp(64px, 14vw, 200px);
      font-weight: 500;
      letter-spacing: -0.04em;
      line-height: 1;
      color: #f2f4f7;
    }
    .band-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      font-size: 13px;
      color: #d9e2f0;
      width: 100%;
    }
    .band-row a {
      color: #f2f4f7;
      text-decoration: none;
    }
    .band-row a:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    /* ---------- Small screens ---------- */
    @media (max-width: 900px) {
      .sec-head {
        grid-template-columns: 1fr;
        gap: 16px;
      }
      .sec-side p,
      .more {
        margin-left: 0;
        text-align: left;
      }
      .usage-row {
        grid-template-columns: 1fr;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .showcase-grid {
        grid-template-columns: 1fr 1fr;
      }
      .showcase-grid > :first-child {
        grid-column: 1 / -1;
      }
      .install-band {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }
    @media (max-width: 1100px) {
      .strip-item {
        width: calc((100% - 32px) / 2.5);
      }
    }
    @media (max-width: 640px) {
      .hero h1 {
        letter-spacing: -0.02em;
      }
      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .strip-item {
        width: calc((100% - 16px) / 1.2);
      }
      .showcase-grid {
        grid-template-columns: 1fr;
      }
      .install-band {
        padding: 24px;
      }
      .install-links {
        flex-direction: column;
        gap: 12px;
        align-items: center;
      }
      .footer-inner {
        flex-direction: column;
      }
      .footer-links {
        gap: 40px;
        flex-wrap: wrap;
      }
      .footer-band {
        height: 300px;
      }
      .band-word {
        font-size: clamp(40px, 13vw, 120px);
      }
    }
  </style>

  <script>
    // Write this, get this: the chips are a single-select Starwind ToggleGroup.
    const usageLive = document.getElementById("usage-live");
    const usageChips = document.getElementById("usage-chips");
    usageChips?.addEventListener("starwind:value-change", (e) => {
      if (!(e instanceof CustomEvent)) return;
      const detail = e.detail as { value?: string[]; toggleValue?: string };
      const i = Number(Array.isArray(detail.value) ? detail.value[0] : detail.toggleValue);
      const chip = usageChips.querySelector<HTMLElement>(`[data-sw-toggle][data-value="${i}"]`);
      if (!chip) return;
      document.querySelectorAll<HTMLElement>("[data-uc]").forEach((uc) => {
        uc.classList.toggle("on", Number(uc.dataset.uc) === i);
      });
      if (usageLive) {
        const el = document.createElement(chip.dataset.el ?? "dither-surface");
        el.setAttribute("aria-hidden", "true");
        el.setAttribute("data-dither", chip.dataset.dd ?? "{}");
        if (chip.dataset.img) el.innerHTML = chip.dataset.img;
        usageLive.replaceChildren(el);
      }
    });

    // Effects filmstrip arrows: scroll the strip, disable at the ends.
    const strip = document.getElementById("strip");
    const stripBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-strip]")];
    const stripUpdate = () => {
      if (!strip) return;
      const max = strip.scrollWidth - strip.clientWidth;
      for (const b of stripBtns) {
        const dir = Number(b.dataset.strip);
        b.disabled = dir < 0 ? strip.scrollLeft <= 4 : strip.scrollLeft >= max - 4;
      }
    };
    stripBtns.forEach((b) =>
      b.addEventListener("click", () => {
        strip?.scrollBy({ left: (strip.clientWidth + 16) * Number(b.dataset.strip), behavior: "smooth" });
      }),
    );
    strip?.addEventListener("scroll", stripUpdate, { passive: true });
    addEventListener("resize", stripUpdate);
    stripUpdate();

    // Back to top: through Lenis when it is running, smooth otherwise,
    // instant when the visitor prefers reduced motion.
    document.querySelector("[data-top]")?.addEventListener("click", (e) => {
      e.preventDefault();
      const lenis = (window as { __lenis?: { scrollTo(t: number): void } }).__lenis;
      if (lenis) return lenis.scrollTo(0);
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });

    // Section entrances.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll("[data-enter]").forEach((el) => io.observe(el));
  </script>
</Base>
